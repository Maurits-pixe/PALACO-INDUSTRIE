XXIII. 🧬 RECONCILIATION PROOF

pub struct ReconciliationProof {
    pub proof_id: ReconciliationProofId,
    pub source_branches: Vec<BranchId>,
    pub source_watermarks: Vec<WatermarkId>,
    pub conflict_set: ConflictSetId,
    pub resolution_set: ResolutionSetId,
