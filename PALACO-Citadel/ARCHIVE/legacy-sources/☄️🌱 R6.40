3. 🔬 FEEDBACK OBJECT

pub struct ConstitutionalFeedback {
    pub feedback_id: FeedbackId,

    pub source_events: Vec<EventId>,
    pub anomaly_refs: Vec<AnomalyId>,
    pub risk_refs: Vec<RiskId>,
    pub decision_refs: Vec<DecisionId>,
