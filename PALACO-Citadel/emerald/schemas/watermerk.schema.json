{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "palaco/emerald/watermerk.schema.json",
  "title": "Emerald Watermerk",
  "type": "object",
  "required": ["id", "world_id", "source", "epoch", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^EM-WM-(EW-[0-9]{4}|IMPERIUM-[0-9]{4}-[0-9]{2}|DISTRICT-[A-Z0-9-]+)$" },
    "world_id": { "type": ["string", "null"], "pattern": "^EW-[0-9]{4}$" },
    "source": { "type": "string" },
    "epoch": { "type": "string" },
    "provenance": { "type": "string" }
  },
  "additionalProperties": true
}
