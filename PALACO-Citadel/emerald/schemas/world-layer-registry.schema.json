{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palaco.local/emerald/schemas/world-layer-registry.schema.json",
  "title": "Emerald World Layer Registry",
  "type": "object",
  "required": [
    "registry_id",
    "source",
    "source_epoch",
    "layers",
    "records"
  ],
  "properties": {
    "registry_id": {
      "const": "THE-EMERALD-IMPERIUM"
    },
    "source": {
      "const": "IMA-CNMNC"
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "layers": {
      "type": "object",
      "required": [
        "mineral_registry",
        "emerald_world_registry",
        "palaco_world_allocation"
      ],
      "properties": {
        "mineral_registry": { "const": "COMPLETE_CANONICAL_SET" },
        "emerald_world_registry": { "const": "ONE_WORLD_ID_PER_MINERAL" },
        "palaco_world_allocation": { "const": "4444_CURRENT_CAPACITY" }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "world_id",
          "world",
          "mineral",
          "registry",
          "allocation",
          "identity",
          "provenance",
          "watermerk",
          "hologram",
          "citadel",
          "immortal",
          "authority"
        ],
        "properties": {
          "world_id": { "type": "string", "pattern": "^EW-[0-9]{4,}$" },
          "world": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "const": "MINERAL-WORLD" }
            },
            "additionalProperties": false
          },
          "mineral": {
            "type": "object",
            "required": ["id", "canonical_name"],
            "properties": {
              "id": { "type": "string", "pattern": "^MIN-[0-9]{4,}$" },
              "canonical_name": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "registry": {
            "type": "object",
            "required": ["id", "source", "epoch"],
            "properties": {
              "id": { "const": "THE-EMERALD-IMPERIUM" },
              "source": { "const": "IMA-CNMNC" },
              "epoch": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
            },
            "additionalProperties": false
          },
          "allocation": {
            "type": "object",
            "required": ["state", "slot"],
            "properties": {
              "state": {
                "type": "string",
                "enum": ["WORLD_ACTIVE", "WORLD_PENDING"]
              },
              "slot": {
                "type": ["string", "null"],
                "pattern": "^OW-[0-9]{4,}$"
              }
            },
            "additionalProperties": false
          },
          "identity": {
            "type": "object",
            "required": ["immutable"],
            "properties": {
              "immutable": { "const": true }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": ["verified", "source_reference"],
            "properties": {
              "verified": { "const": true },
              "source_reference": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "watermerk": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^EM-WM-EW-[0-9]{4,}$" }
            },
            "additionalProperties": false
          },
          "hologram": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^EM-HO-EW-[0-9]{4,}$" }
            },
            "additionalProperties": false
          },
          "citadel": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^CITADEL-EM-EW-[0-9]{4,}$" }
            },
            "additionalProperties": false
          },
          "immortal": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^IMMORTAL-EM-EW-[0-9]{4,}$" }
            },
            "additionalProperties": false
          },
          "expansion": {
            "type": "object",
            "required": ["eligible", "reason"],
            "properties": {
              "eligible": { "type": "boolean" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "authority": {
            "type": "object",
            "required": ["sovereign", "constitutional"],
            "properties": {
              "sovereign": { "const": false },
              "constitutional": { "const": false }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "allocation": {
                  "properties": {
                    "state": { "const": "WORLD_PENDING" }
                  },
                  "required": ["state"]
                }
              }
            },
            "then": {
              "required": ["expansion"]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
